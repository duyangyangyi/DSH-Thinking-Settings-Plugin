{
  "name": "dsh-thinking-language",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Lock the model's reasoning language (English or Simplified Chinese) from General Settings; replies follow the user's language.",
  "main": "./index.js",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "configForms"
      ],
      "external": [
        "react"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duyangyangyi/DSH-Thinking-Settings-Plugin.git"
  },
  "homepage": "https://github.com/duyangyangyi/DSH-Thinking-Settings-Plugin"
}
